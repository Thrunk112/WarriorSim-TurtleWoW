{
    "name": "WarriorSim-TurtleWoW",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "11.15.0"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "dbaeumer.vscode-eslint"
            ]
        }
    },
    "postCreateCommand": "npm install",
    "forwardPorts": [
        3000,
        3001
    ],
    "remoteUser": "vscode"
}